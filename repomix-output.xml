}
.final-score{
  font-family:'Cormorant Garamond', serif;
  font-size: 2.6rem;
  font-weight:600;
  color: var(--maroon);
}
footer{
  margin-top:10px;
  font-size:0.78rem;
  opacity:0.55;
  text-align:center;
}
