<body>
<div id="app">
  <h1>Skripka Flappy</h1>
  <div class="subtitle">Səsinin tezliyi ilə quşu idarə et. Hər boru cütü müəyyən bir nota tələb edir — o notanı çal (və ya oxu), quş həmin hündürlüyə qalxsın.</div>

  <div class="stage-wrap">
    <canvas id="game" width="720" height="480"></canvas>

    <div class="hud">
      <div class="score" id="scoreEl">0</div>
      <div class="pitch-readout" id="pitchEl">— <br><b>—</b></div>
    </div>

    <div class="overlay" id="startOverlay">
      <h2>Başlamazdan əvvəl</h2>
      <p>Mikrofon icazəsi lazımdır. Skripkanı yaxınlaşdır və ya səslə oxu — proqram avtomatik tezliyi (Hz) tutub notaya çevirəcək.</p>
      <div class="note-legend" id="legend"></div>
      <button class="primary" id="startBtn">Mikrofonu aç və başla</button>
      <div class="mic-status" id="micStatus"></div>
    </div>

    <div class="overlay" id="overOverlay" style="display:none;">
      <h2>Oyun bitdi</h2>
      <div class="final-score" id="finalScore">0</div>
      <p id="overNote"></p>
      <button class="primary" id="retryBtn">Yenidən cəhd et</button>
    </div>
  </div>
  <footer>Diapazon: G3 (196 Hz) — E5 (659 Hz), skripkanın açıq simləri arasındakı zona</footer>
</div>

<script>
(function(){
  const canvas = document.getElementById('game');
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;

  const NOTE_MARGIN_L = 46;
  const PLAY_TOP = 24;
  const PLAY_BOTTOM = H - 24;

  // Notes usable for both the staff grid and pipe targets (G3 -> E5)
  const NOTES = [
    {name:'G3', freq:196.00},
    {name:'A3', freq:220.00},
    {name:'B3', freq:246.94},
    {name:'C4', freq:261.63},
    {name:'D4', freq:293.66},
    {name:'E4', freq:329.63},
    {name:'F#4', freq:369.99},
    {name:'G4', freq:392.00},
    {name:'A4', freq:440.00},
    {name:'B4', freq:493.88},
    {name:'C5', freq:523.25},
    {name:'D5', freq:587.33},
    {name:'E5', freq:659.25},
  ];
  const MIN_F = NOTES[0].freq * 0.94;
  const MAX_F = NOTES[NOTES.length-1].freq * 1.06;

  function freqToY(freq){
    const f = Math.max(MIN_F, Math.min(MAX_F, freq));
    const t = (Math.log2(f) - Math.log2(MIN_F)) / (Math.log2(MAX_F) - Math.log2(MIN_F));
    return PLAY_BOTTOM - t * (PLAY_BOTTOM - PLAY_TOP);
  }

  // legend
  const legend = document.getElementById('legend');
  NOTES.forEach(n=>{
    const chip = document.createElement('div');
    chip.className = 'note-chip';
    chip.textContent = n.name + ' · ' + Math.round(n.freq) + 'Hz';
    legend.appendChild(chip);
  });

  // ---------- Audio / pitch detection ----------
  let audioCtx, analyser, micStream, dataBuf;
  let smoothedFreq = 0;
  let lastConfidentFreq = 0;
  let hasSignal = false;

  async function initMic(){
    micStream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation:false, noiseSuppression:false, autoGainControl:false } });
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    const source = audioCtx.createMediaStreamSource(micStream);
    analyser = audioCtx.createAnalyser();
    analyser.fftSize = 2048;
    source.connect(analyser);
    dataBuf = new Float32Array(analyser.fftSize);
  }

  function autoCorrelate(buf, sampleRate){
    const SIZE = buf.length;
    let rms = 0;
    for (let i=0;i<SIZE;i++) rms += buf[i]*buf[i];
    rms = Math.sqrt(rms/SIZE);
    if (rms < 0.012) return -1;

    let r1=0, r2=SIZE-1;
    const thres = 0.2;
    for (let i=0;i<SIZE/2;i++){ if (Math.abs(buf[i])<thres){ r1=i; break; } }
    for (let i=1;i<SIZE/2;i++){ if (Math.abs(buf[SIZE-i])<thres){ r2=SIZE-i; break; } }
    const trimmed = buf.slice(r1, r2);
    const n = trimmed.length;
    if (n < 8) return -1;

    const c = new Float32Array(n);
    for (let lag=0; lag<n; lag++){
      let sum = 0;
      for (let i=0; i<n-lag; i++) sum += trimmed[i]*trimmed[i+lag];
      c[lag] = sum;
    }

    let d = 0;
    while (d < n-1 && c[d] > c[d+1]) d++;

    let maxVal = -1, maxPos = -1;
    for (let i=d; i<n; i++){
      if (c[i] > maxVal){ maxVal = c[i]; maxPos = i; }
    }
    if (maxPos <= 0) return -1;

    let T0 = maxPos;
    if (maxPos > 0 && maxPos < n-1){
      const x1=c[maxPos-1], x2=c[maxPos], x3=c[maxPos+1];
      const a=(x1+x3-2*x2)/2, b=(x3-x1)/2;
      if (a !== 0) T0 = maxPos - b/(2*a);
    }
    const freq = sampleRate / T0;
    if (freq < 60 || freq > 1500) return -1;
    return freq;
  }

  function nearestNoteName(freq){
    if (!freq || freq<=0) return '—';
    const midi = 69 + 12*Math.log2(freq/440);
    const rounded = Math.round(midi);
    const names = ['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];
    const name = names[(rounded%12+12)%12];
    const octave = Math.floor(rounded/12) - 1;
    return name + octave;
  }

  function updatePitch(){
    if (!analyser) return;
    analyser.getFloatTimeDomainData(dataBuf);
    const f = autoCorrelate(dataBuf, audioCtx.sampleRate);
    if (f > 0){
      hasSignal = true;
      lastConfidentFreq = f;
      smoothedFreq = smoothedFreq ? smoothedFreq*0.65 + f*0.35 : f;
    } else {
      hasSignal = false;
    }
  }

  // ---------- Game state ----------
  let birdY = H/2;
  let birdTargetY = H/2;
  const BIRD_X = 150;
  const BIRD_R = 14;
  let velocitySmoothing = 0.16;

  let pipes = [];
  const PIPE_GAP = 140;
  const PIPE_W = 46;
  let pipeSpeed = 2.6;
  let frame = 0;
  let score = 0;
  let running = false;
  let gameOver = false;

  function spawnPipe(){
    const note = NOTES[Math.floor(Math.random()*NOTES.length)];
    const gapCenterY = freqToY(note.freq);
    pipes.push({
      x: W + 40,
      note: note,
      gapCenterY: gapCenterY,
      passed: false
    });
  }

  function resetGame(){
    pipes = [];
    score = 0;
    frame = 0;
    pipeSpeed = 2.6;
    birdY = H/2;
    birdTargetY = H/2;
    gameOver = false;
    spawnPipe();
  }

  function drawStaff(){
    ctx.save();
    ctx.strokeStyle = 'rgba(59,42,32,0.28)';
    ctx.lineWidth = 1;
    ctx.font = "13px 'EB Garamond', serif";
    ctx.fillStyle = 'rgba(59,42,32,0.65)';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    NOTES.forEach(n=>{
      const y = freqToY(n.freq);
      ctx.beginPath();
      ctx.moveTo(NOTE_MARGIN_L, y);
      ctx.lineTo(W-10, y);
      ctx.stroke();
      ctx.fillText(n.name, 8, y);
    });
    ctx.restore();
  }

  function drawPipe(p){
    const gapTop = p.gapCenterY - PIPE_GAP/2;
    const gapBottom = p.gapCenterY + PIPE_GAP/2;

    ctx.save();
    const grad = ctx.createLinearGradient(p.x,0,p.x+PIPE_W,0);
    grad.addColorStop(0, '#6b4a36');
    grad.addColorStop(0.5, '#5C4030');
    grad.addColorStop(1, '#4a3226');
    ctx.fillStyle = grad;

    // top pillar
    ctx.fillRect(p.x, PLAY_TOP-10, PIPE_W, Math.max(0, gapTop-(PLAY_TOP-10)));
    // bottom pillar
    ctx.fillRect(p.x, gapBottom, PIPE_W, Math.max(0, (PLAY_BOTTOM+10)-gapBottom));

    // scroll caps
    ctx.fillStyle = '#3E2A1F';
    ctx.fillRect(p.x-3, gapTop-14, PIPE_W+6, 14);
    ctx.fillRect(p.x-3, gapBottom, PIPE_W+6, 14);

    // note label at gap
    ctx.fillStyle = '#7A2333';
    ctx.font = "bold 15px 'Cormorant Garamond', serif";
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(p.note.name, p.x + PIPE_W/2, p.gapCenterY);
    ctx.restore();
  }

  function drawBird(){
    ctx.save();
    ctx.translate(BIRD_X, birdY);
    // eighth-note glyph
    ctx.fillStyle = hasSignal ? '#C9A44C' : '#9c8256';
    ctx.strokeStyle = '#3E2A1F';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.ellipse(0, 8, 9, 6.5, -0.35, 0, Math.PI*2);
    ctx.fill();
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(7,4);
    ctx.lineTo(7,-24);
    ctx.lineTo(10,-24);
    ctx.quadraticCurveTo(16,-16, 9,-8);
    ctx.lineTo(9,4);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    ctx.restore();
  }

  function loop(){
    if (!running) return;
    frame++;
    updatePitch();

    if (hasSignal){
      birdTargetY = freqToY(smoothedFreq);
    } else {
      birdTargetY += 2.2; // gentle gravity fall when silent
    }
    birdTargetY = Math.max(PLAY_TOP+BIRD_R, Math.min(PLAY_BOTTOM-BIRD_R, birdTargetY));
    birdY += (birdTargetY - birdY) * velocitySmoothing;

    // move pipes
    pipes.forEach(p => p.x -= pipeSpeed);
    if (pipes.length && pipes[pipes.length-1].x < W - 280){
      spawnPipe();
    }
    pipes = pipes.filter(p => p.x > -PIPE_W - 20);

    // collision + scoring
    for (const p of pipes){
      const withinX = BIRD_X + BIRD_R > p.x && BIRD_X - BIRD_R < p.x + PIPE_W;
      if (withinX){
        const gapTop = p.gapCenterY - PIPE_GAP/2;
        const gapBottom = p.gapCenterY + PIPE_GAP/2;
        if (birdY - BIRD_R < gapTop || birdY + BIRD_R > gapBottom){
          endGame();
          return;
        }
      }
      if (!p.passed && p.x + PIPE_W < BIRD_X - BIRD_R){
        p.passed = true;
        score++;
        pipeSpeed = Math.min(5.2, pipeSpeed + 0.06);
        document.getElementById('scoreEl').textContent = score;
      }
    }

    // render
    ctx.clearRect(0,0,W,H);
    drawStaff();
    pipes.forEach(drawPipe);
    drawBird();

    const readout = document.getElementById('pitchEl');
    if (hasSignal){
      readout.innerHTML = Math.round(smoothedFreq) + ' Hz <br><b>' + nearestNoteName(smoothedFreq) + '</b>';
    } else {
      readout.innerHTML = 'səssiz <br><b>—</b>';
    }

    requestAnimationFrame(loop);
  }

  function endGame(){
    running = false;
    gameOver = true;
    document.getElementById('finalScore').textContent = score;
    document.getElementById('overNote').textContent = score === 0
      ? 'Boruların arasından keçmək üçün lazımi notanı dəqiq tut.'
      : 'Yaxşı nəticə! Diapazonu genişləndirmək üçün yenidən cəhd et.';
    document.getElementById('overOverlay').style.display = 'flex';
  }

  function startGame(){
    document.getElementById('startOverlay').style.display = 'none';
    document.getElementById('overOverlay').style.display = 'none';
    resetGame();
    running = true;
    requestAnimationFrame(loop);
  }

  document.getElementById('startBtn').addEventListener('click', async () => {
    const statusEl = document.getElementById('micStatus');
    try{
      statusEl.textContent = 'Mikrofon icazəsi gözlənilir...';
      await initMic();
      if (audioCtx.state === 'suspended') await audioCtx.resume();
      statusEl.textContent = '';
      startGame();
    } catch(err){
      statusEl.textContent = 'Mikrofona giriş alınmadı: ' + err.message;
    }
  });

  document.getElementById('retryBtn').addEventListener('click', () => {
    startGame();
  });

  // initial static draw
  drawStaff();
})();
</script>
</body>
</html>
</file>

