:root{
  --parchment: #EFE6D3;
  --parchment-dark: #E3D6BC;
  --ink: #3B2A20;
  --walnut: #5C4030;
  --walnut-dark: #3E2A1F;
  --maroon: #7A2333;
  --gold: #C9A44C;
  --gold-bright: #E4C878;
  --line: rgba(59,42,32,0.55);
}
*{ box-sizing: border-box; }
html,body{
  margin:0; padding:0; height:100%;
  background: radial-gradient(ellipse at 50% -10%, #FBF6E9 0%, var(--parchment) 55%, var(--parchment-dark) 100%);
  font-family: 'EB Garamond', serif;
  color: var(--ink);
  overflow: hidden;
}
#app{
  position: relative;
  width: 100%;
  max-width: 900px;
  margin: 0 auto;
  height: 100vh;
  display:flex;
  flex-direction: column;
  align-items:center;
  justify-content:center;
}
h1{
  font-family: 'Cormorant Garamond', serif;
  font-weight: 600;
  font-style: italic;
  font-size: clamp(1.6rem, 4vw, 2.6rem);
  letter-spacing: 0.02em;
  color: var(--maroon);
  margin: 0 0 2px 0;
  text-align:center;
}
.subtitle{
  font-size: 0.95rem;
  color: var(--ink);
  opacity: 0.75;
  margin-bottom: 14px;
  text-align:center;
  max-width: 520px;
  line-height:1.4;
}
.stage-wrap{
  position: relative;
  border-radius: 6px;
  box-shadow: 0 18px 40px rgba(59,42,32,0.28), 0 0 0 1px rgba(59,42,32,0.12);
  background: var(--parchment);
  overflow:hidden;
}
canvas{
  display:block;
  background: transparent;
}
.hud{
  position:absolute;
  top: 14px;
  left: 0; right:0;
  display:flex;
  justify-content: space-between;
  padding: 0 20px;
  pointer-events:none;
  font-family: 'Cormorant Garamond', serif;
}
.hud .score{
  font-size: 1.8rem;
  font-weight:600;
  color: var(--maroon);
  text-shadow: 0 1px 0 rgba(255,255,255,0.6);
}
.hud .pitch-readout{
  text-align:right;
  font-size:1rem;
  color: var(--ink);
  background: rgba(239,230,211,0.85);
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 4px 10px;
  line-height: 1.3;
}
.pitch-readout b{ color: var(--maroon); font-size:1.15rem; }
.overlay{
  position:absolute; inset:0;
  background: rgba(239,230,211,0.94);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding: 20px;
  gap: 14px;
}
.overlay h2{
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-weight:600;
  color: var(--maroon);
  font-size: clamp(1.4rem, 3.2vw, 2rem);
  margin: 0;
}
.overlay p{ max-width: 480px; line-height:1.55; margin: 0; font-size:0.98rem; }
.note-legend{
  display:flex; flex-wrap:wrap; gap:6px; justify-content:center; max-width:480px;
}
.note-chip{
  font-size:0.8rem; padding:3px 9px; border:1px solid var(--line); border-radius: 999px;
  background: var(--parchment-dark);
}
button.primary{
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-weight:600;
